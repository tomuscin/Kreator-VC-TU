# Kreator CV — Tomasz Uściński — zmienne środowiskowe
# Skopiuj do .env i uzupełnij wartości
# NIE commituj .env do repozytorium

# ── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_PRIMARY=gpt-4.1
OPENAI_MODEL_FALLBACK=gpt-4.1-mini
OPENAI_MODEL_MINI=gpt-4.1-mini

# ── Email (SMTP via Gmail App Password) ───────────────────────────
# Użyj Gmail App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj@gmail.com
SMTP_PASSWORD=
SMTP_FROM=twoj@gmail.com
SMTP_FROM_NAME=Tomasz Uściński

# ── Basic Auth (chroni app na Render) ─────────────────────────────
# Ustaw też w Render dashboard jako env vars
APP_USERNAME=tomasz
APP_PASSWORD=bezpieczne_haslo

# ── Baza danych (MySQL/MariaDB na WEBD.pl) ─────────────────────────
# Ustaw DB_ENABLED=true aby włączyć zapis historii CV
DB_ENABLED=false
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── FTP (zapis DOCX na serwerze WEBD.pl) ───────────────────────────
# Ustaw FTP_ENABLED=true aby włączyć upload plików DOCX na FTP
# W Render Dashboard ustaw: FTP_ENABLED=true + FTP_PASSWORD=<haslo>
# FTP mode: passive | port: 21 | serwer: ftp.tomuscin.webd.pro
FTP_ENABLED=false
FTP_HOST=ftp.tomuscin.webd.pro
FTP_PORT=21
FTP_USER=tomasz@lexaro.co
FTP_PASSWORD=
FTP_BASE_DIR=/cv-kreator/generated
FTP_PUBLIC_BASE_URL=
