# Kreator CV — Tomasz Uściński — zmienne środowiskowe
# Skopiuj do .env i uzupełnij wartości
# NIE commituj .env do repozytorium

# ── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_PRIMARY=gpt-5.5
OPENAI_MODEL_FALLBACK=gpt-5.4
OPENAI_MODEL_MINI=gpt-5.4-mini

# ── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=mail.tomaszuscinski.pl
SMTP_PORT=465
SMTP_USER=tomasz@tomaszuscinski.pl
SMTP_PASSWORD=twoje_haslo_do_poczty
SMTP_FROM=tomasz@tomaszuscinski.pl
SMTP_FROM_NAME=Tomasz Uściński

# ── Basic Auth (chroni app na Render) ─────────────────────────────
# Ustaw też w Render dashboard jako env vars
APP_USERNAME=tomasz
APP_PASSWORD=bezpieczne_haslo

# ── Baza danych (MySQL/MariaDB na WEBD.pl) ─────────────────────────
# Ustaw DB_ENABLED=true aby włączyć zapis historii CV
DB_ENABLED=false
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── FTP (zapis DOCX na serwerze WEBD.pl) ───────────────────────────
# Ustaw FTP_ENABLED=true aby włączyć upload plików DOCX na FTP
FTP_ENABLED=false
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BASE_DIR=/cv-kreator/generated
FTP_PUBLIC_BASE_URL=
